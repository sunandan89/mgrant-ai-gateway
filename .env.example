# The LLM key lives ONLY here (never on a tenant Frappe site)
ANTHROPIC_API_KEY=sk_test_placeholder

# Current Claude model string to use
MGRANT_AI_MODEL=claude-sonnet-4-5

# Tenants: map each tenant's gateway token -> tenant id + monthly budget (INR)
# The token is what each Frappe site stores as mgrant_ai_gateway_key
MGRANT_AI_TENANTS={"bfs-uat-token-REPLACE":{"tenant_id":"bfs","monthly_budget":5000}}

# Cost rates per model, INR per 1,000,000 tokens (set to your contracted rates)
MGRANT_AI_RATES={"claude-sonnet-4-5":{"in":250,"out":1250}}

# Usage/audit store (SQLite for pilot; use Postgres in production)
MGRANT_AI_DB=usage.db
